{
  "expo": {
    "name": "KODA",
    "slug": "koda",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "koda",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.koda.enfant"
    },
    "android": {
      "package": "app.koda.enfant",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
