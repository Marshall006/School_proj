# Copiez ce fichier en `.env` et adaptez les valeurs.

# --- API -------------------------------------------------------------------
KODA_ENVIRONMENT=dev
KODA_DEBUG=true
KODA_SECRET_KEY=remplacez-par-une-cle-aleatoire-de-48-octets
KODA_CORS_ORIGINS=http://localhost:3000

# Par defaut, l'API utilise une base SQLite locale : rien a installer.
# En production (et dans docker-compose), passez a PostgreSQL :
# KODA_DATABASE_URL=postgresql+asyncpg://koda:koda@localhost:5432/koda

# --- Regles pedagogiques par defaut ---------------------------------------
KODA_DEFAULT_PASS_SCORE_PCT=70
KODA_DEFAULT_COOLDOWN_MINUTES=120
KODA_DEFAULT_REWARD_MINUTES=180
KODA_DEFAULT_QUESTION_COUNT=10

# --- Firebase (facultatif : sans cela, authentification locale) -----------
# KODA_FIREBASE_PROJECT_ID=mon-projet-firebase

# --- Clients ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_ENABLED=false
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
