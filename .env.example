# Configuration de l'API. Copiez ce fichier en `.env` a la racine.
#
# Les clients ont leur propre fichier, car Next.js et Expo lisent le `.env`
# de LEUR dossier et non celui de la racine :
#   web/.env.example     -> tableau de bord parental
#   mobile/.env.example  -> application enfant

# --- Identite et journalisation --------------------------------------------
KODA_ENVIRONMENT=dev
KODA_DEBUG=true

# --- Securite ---------------------------------------------------------------
# Obligatoire en production. Generez-la avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KODA_SECRET_KEY=remplacez-par-une-cle-aleatoire-de-48-octets

# --- Base de donnees --------------------------------------------------------
# Par defaut, l'API utilise une base SQLite locale (backend/koda.db) : rien a
# installer. En production, passez a PostgreSQL :
# KODA_DATABASE_URL=postgresql+asyncpg://koda:koda@localhost:5432/koda

# --- Origines autorisees ----------------------------------------------------
# Ajoutez l'adresse reseau de la machine si vous ouvrez le tableau de bord
# depuis un autre appareil.
KODA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Regles pedagogiques par defaut ----------------------------------------
KODA_DEFAULT_PASS_SCORE_PCT=70
KODA_DEFAULT_COOLDOWN_MINUTES=120
KODA_DEFAULT_REWARD_MINUTES=180
KODA_DEFAULT_QUESTION_COUNT=10

# --- Firebase (facultatif) --------------------------------------------------
# Sans cela, l'authentification locale par mot de passe suffit.
# KODA_FIREBASE_PROJECT_ID=mon-projet-firebase
